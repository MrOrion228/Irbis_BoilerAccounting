<Page x:Class="Irbis.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Отчёты">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Вертикальное расположение кнопок -->
        <StackPanel Grid.Row="0" 
                    Orientation="Vertical" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
            <Button Content="Отчёт по приходу" Width="200" Margin="5" Click="ReportArrivals_Click" Background="#FF0D99AB"/>
            <Button Content="Отчёт по продаже" Width="200" Margin="5" Click="ReportSales_Click" Background="#FF0D99AB"/>
            <Button Content="Отчёт по остаткам" Width="200" Margin="5" Click="ReportStock_Click" Background="#FF0D99AB"/>
        </StackPanel>
        <Button Grid.Row="1" Content="Назад" Width="100" Margin="5" HorizontalAlignment="Center" Click="BackBtn_Click" Background="#FFC73B3B"/>
    </Grid>
</Page>