<Page x:Class="Irbis.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">
    <Grid Background="#F0F2F5">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
            <Border Background="White" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Вход в систему" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,20"/>
                    <TextBlock Text="Логин" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtLogin" Height="35" Margin="0,0,0,15"/>
                    <TextBlock Text="Пароль" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPassword" Height="35" Margin="0,0,0,20"/>
                    <Button Content="Войти" 
                            Height="40" 
                            Background="#FF0D99AB" 
                            Foreground="White" 
                            FontWeight="Bold"
                            Click="Login_Click"/>
                    <TextBlock x:Name="lblError" 
                               Foreground="Red" 
                               TextWrapping="Wrap" 
                               HorizontalAlignment="Center" 
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>