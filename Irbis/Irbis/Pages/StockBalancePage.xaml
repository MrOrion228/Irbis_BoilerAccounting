<Page x:Class="Irbis.Pages.StockBalancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Irbis.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Остатки котлов">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="5">
            <Button Content="Обновить" Width="100" Margin="5" Click="Refresh_Click" Background="#FF0D99AB"/>
            <Button Content="Назад" Width="100" Margin="5" Click="BackBtn_Click" Background="#FFC73B3B"/>
        </StackPanel>
        <DataGrid x:Name="dgBalance" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" Margin="5"/>
    </Grid>
</Page>