<Page x:Class="Irbis.Pages.AddEditCustomersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Irbis.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
     Title="Покупатель">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
        <TextBlock Text="Наименование покупателя" Margin="5" FontWeight="Bold"/>
        <TextBox x:Name="txtName" Margin="5" Height="30" />

        <TextBlock Text="Контактные данные (адрес, телефон)" Margin="5" FontWeight="Bold"/>
        <TextBox x:Name="txtContact" Margin="5" Height="30" TextWrapping="Wrap" AcceptsReturn="True"/>

        <Button Content="Сохранить" Margin="5" Height="35" Width="150" Click="SaveBtn_Click" Background="#FF0D99AB"/>
        <Button Content="Отмена" Margin="5" Height="35" Width="150" Click="BackBtn_Click" Background="#FFC73B3B"/>
    </StackPanel>
</Page>