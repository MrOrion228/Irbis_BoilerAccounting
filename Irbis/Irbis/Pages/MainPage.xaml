<Page x:Class="Irbis.Pages.MainPage"
       Loaded="Page_Loaded"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главное меню">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="233*"/>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Grid.RowSpan="2">
            <Button x:Name="NomenclaturesBtn" Content="Номенклатура" Width="250" Margin="5" Click="NomenclaturesBtn_Click" Background="#FF0D99AB"/>
            <Button x:Name="SuppliersBtn" Content="Поставщики" Width="250" Margin="5" Click="SuppliersBtn_Click" Background="#FF0D99AB"/>
            <Button x:Name="CustomersBtn" Content="Покупатели" Width="250" Margin="5" Click="CustomersBtn_Click" Background="#FF0D99AB"/>
            <Button x:Name="ArrivalsBtn" Content="Приход котлов" Width="250" Margin="5" Click="ArrivalsBtn_Click" Background="#FF0D99AB"/>
            <Button x:Name="SalesBtn" Content="Продажа котлов" Width="250" Margin="5" Click="SalesBtn_Click" Background="#FF0D99AB"/>
            <Button x:Name="StockBalanceBtn" Content="Остатки на складе" Width="250" Margin="5" Click="StockBalanceBtn_Click" Background="#FF0D99AB"/>
            <Button x:Name="ReportsBtn" Content="Отчёты" Width="250" Margin="5" Click="ReportsBtn_Click" Background="#FF0D99AB"/>
            <Button x:Name="ExitBtn" Content="Выход" Width="250" Margin="5" Click="ExitBtn_Click" Background="#FFC73B3B"/>
        </StackPanel>
    </Grid>
</Page>