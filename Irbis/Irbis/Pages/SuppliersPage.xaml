<Page x:Class="Irbis.Pages.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Irbis.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
       Title="Поставщики">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель кнопок действий и навигации -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button x:Name="AddBtn" Content="Добавить" Width="80" Margin="5" Click="AddBtn_Click" Background="#FF0D99AB"/>
            <Button x:Name="DeleteBtn" Content="Удалить" Width="80" Margin="5" Click="DeleteBtn_Click" Background="#FFC73B3B"/>
            <Separator Width="10" Visibility="Collapsed"/>
            <Button Content="Первая" Width="60" Margin="2" Click="First_Click" Background="#FF0D99AB"/>
            <Button Content="Предыдущая" Width="80" Margin="2" Click="Prev_Click" Background="#FF0D99AB"/>
            <Button Content="Следующая" Width="80" Margin="2" Click="Next_Click" Background="#FF0D99AB"/>
            <Button Content="Последняя" Width="60" Margin="2" Click="Last_Click" Background="#FF0D99AB"/>
            <Separator Width="10" Visibility="Collapsed"/>
            <Button Content="Назад" Width="80" Margin="5" Click="BackBtn_Click" Background="#FFC73B3B"/>
        </StackPanel>

        <!-- DataGrid с ручным описанием столбцов -->
        <DataGrid x:Name="dgSuppliers" Grid.Row="1" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Single" Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="Auto"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="3*"/>
                <DataGridTextColumn Header="Контактные данные" Binding="{Binding Contact}" Width="4*"/>
                <DataGridTemplateColumn Header="Действие" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Изменить" Click="EditBtn_Click" Tag="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статусная строка (номер текущей записи) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Запись:" Margin="5,0"/>
            <TextBlock x:Name="txtCurrentRecord" Margin="5,0"/>
            <TextBlock Text="из" Margin="5,0"/>
            <TextBlock x:Name="txtTotalRecords" Margin="5,0"/>
        </StackPanel>
    </Grid>
</Page>